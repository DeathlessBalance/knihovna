rules_version = '2';

// Pravidla pro databázi Firestore. Zkopíruj celý obsah do Firebase konzole
// (Firestore Database → Rules) a klikni na Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /books/{bookId} {
      allow read: if true;
      // Nový titul musí mít název a patřit jedné z uživatelek.
      // Jména musí odpovídat USERS v config.js.
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.owner in ['Veyra', 'Nyx'];
      allow update: if request.resource.data.owner in ['Veyra', 'Nyx'];
      allow delete: if true;
    }
  }
}
